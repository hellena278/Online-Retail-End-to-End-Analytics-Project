{
  "name": "Retail Clean (accessible)",
  "dataColors": ["#1F3A5F", "#2A9D8F", "#E9A23B", "#C8384B", "#6C5B9E", "#5B6B7C", "#7BC4BA", "#9AA5B1"],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#1F3A5F",
  "good": "#2A9D8F",
  "neutral": "#E9A23B",
  "bad": "#C8384B",
  "maximum": "#1F3A5F",
  "center": "#7BC4BA",
  "minimum": "#E8EEF4",
  "null": "#9AA5B1",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "title": { "fontSize": 14, "fontFace": "Segoe UI Semibold", "color": "#1F3A5F" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F3A5F" },
    "label": { "fontSize": 11, "fontFace": "Segoe UI", "color": "#3E4C59" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [{
          "show": true,
          "fontColor": { "solid": { "color": "#1F3A5F" } },
          "fontSize": 14,
          "fontFamily": "Segoe UI Semibold",
          "alignment": "left"
        }],
        "background": [{
          "show": true,
          "color": { "solid": { "color": "#FFFFFF" } },
          "transparency": 0
        }],
        "border": [{
          "show": true,
          "color": { "solid": { "color": "#D9DEE5" } },
          "radius": 8
        }],
        "visualHeader": [{ "show": false }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6F8" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#E8EBEF" } }, "transparency": 0 }]
      }
    }
  }
}
